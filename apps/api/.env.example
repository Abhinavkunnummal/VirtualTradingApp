# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGINS=https://app.tradeverse.ai,http://localhost:3000

# Database Persistence
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tradeverse?retryWrites=true&w=majority

# JWT Security Secrets (minimum 32 characters, high entropy)
JWT_ACCESS_SECRET=replace_with_64_char_cryptographically_secure_random_key_for_access
JWT_REFRESH_SECRET=replace_with_64_char_cryptographically_secure_random_key_for_refresh

# Default Virtual Simulation Settings
STARTING_CAPITAL=1000000

# AI Assistant Integration (Optional - Falls back to deterministic financial knowledge engine)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER_KEY=

# Real-time WebSocket and Market Data (Alpha Vantage / Yahoo Finance / Simulator)
MARKET_DATA_PROVIDER_KEY=
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
